# PostgreSQL Database Config
POSTGRES_PASSWORD=postgres-carpool-secure-pass

# JWT Secret - Must be at least 32 characters long
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long

# Realtime Secret Key Base (minimum 64 characters)
SECRET_KEY_BASE=super-secret-key-base-must-be-at-least-64-characters-long-realtime-carpool

# PostgREST Configuration
PGRST_JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long

# Pre-Generated JWT Keys (HS256 signed with JWT_SECRET)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgxMTU2MzU4LCJleHAiOjIwOTY1MTk5NTh9.NG09cBenuQ6omR9yXqHYfG39PEqPr3eY-h2yhvkxnHg
